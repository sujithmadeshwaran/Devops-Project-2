Task 11 – Project Workspace Generator

echo "How many modules do you want to create?"
read modules

for ((i=1; i<=modules; i++))
do
    mkdir -p Module$i
    touch Module$i/README.md
    touch Module$i/notes.txt
    touch Module$i/config.conf
done

echo "============================================"
echo "Project Workspace Created Successfully"
echo "============================================"

